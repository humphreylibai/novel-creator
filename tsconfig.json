{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "jsx": "react-jsx",
    "types": ["node", "vitest/globals"], "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src", "tests"]
}
